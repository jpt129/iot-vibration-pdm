# .env.example — COMMIT THIS FILE. Copy to .env and adjust.
# .env is gitignored and is the source of truth at runtime.

# ----- Postgres / TimescaleDB -----
POSTGRES_DB=iotpdm
POSTGRES_USER=iotpdm
POSTGRES_PASSWORD=iotpdm-dev-change-me
POSTGRES_HOST=timescale
POSTGRES_PORT=5432

# ----- MQTT -----
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_WORKER_USER=worker
MQTT_WORKER_PASS=worker-secret-change-me

# ----- Worker tuning -----
WORKER_LATE_TOLERANCE_S=60
WORKER_DLQ_TABLE=dlq
WORKER_LOG_LEVEL=INFO
WORKER_ANOMALY_THRESHOLD=0.6
WORKER_BASELINE_WINDOW=300

# ----- Grafana -----
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin-change-me
GF_INSTALL_PLUGINS=

# ----- Streamlit -----
STREAMLIT_PORT=8501

# ----- FastAPI control plane -----
API_PORT=8080
