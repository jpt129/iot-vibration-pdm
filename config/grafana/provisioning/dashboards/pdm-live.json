{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "id": 1,
      "title": "RMS acceleration (g) - last 30 min",
      "type": "timeseries",
      "gridPos": {"h": 9, "w": 14, "x": 0, "y": 0},
      "datasource": {"type": "postgres", "uid": "pdm-timescale"},
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT time AS \"time\", rms_g AS \"RMS (g)\" FROM features WHERE device_id = '$device_id' AND $__timeFilter(time) ORDER BY time"
        },
        {
          "refId": "B",
          "format": "time_series",
          "rawSql": "SELECT time AS \"time\", rms_g AS \"ANOMALY\" FROM features WHERE device_id = '$device_id' AND anomaly_flag = true AND $__timeFilter(time) ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"lineWidth": 2, "fillOpacity": 10, "showPoints": "never"},
          "color": {"mode": "palette-classic"}
        },
        "overrides": [
          {
            "matcher": {"id": "byName", "options": "ANOMALY"},
            "properties": [
              {"id": "custom.drawStyle", "value": "points"},
              {"id": "custom.pointSize", "value": 10},
              {"id": "color", "value": {"mode": "fixed", "fixedColor": "red"}}
            ]
          }
        ]
      },
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 2,
      "title": "Records collected (10k+ proof)",
      "type": "stat",
      "gridPos": {"h": 5, "w": 5, "x": 14, "y": 0},
      "datasource": {"type": "postgres", "uid": "pdm-timescale"},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM features"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "orange"},
              {"value": 10000, "color": "green"}
            ]
          }
        }
      },
      "options": {"colorMode": "background", "graphMode": "area", "textMode": "value"}
    },
    {
      "id": 3,
      "title": "Device live (last 30s)",
      "type": "stat",
      "gridPos": {"h": 5, "w": 5, "x": 19, "y": 0},
      "datasource": {"type": "postgres", "uid": "pdm-timescale"},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT CASE WHEN max(time) > now() - interval '30 seconds' THEN 1 ELSE 0 END AS value FROM features WHERE device_id = '$device_id'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "OFFLINE", "color": "red"}, "1": {"text": "ONLINE", "color": "green"}}}
          ]
        }
      },
      "options": {"colorMode": "background", "textMode": "value"}
    },
    {
      "id": 4,
      "title": "Anomalies (last 1h)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 10, "x": 14, "y": 5},
      "datasource": {"type": "postgres", "uid": "pdm-timescale"},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS value FROM features WHERE device_id = '$device_id' AND anomaly_flag = true AND time > now() - interval '1 hour'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"value": null, "color": "green"},
              {"value": 1, "color": "yellow"},
              {"value": 10, "color": "red"}
            ]
          }
        }
      },
      "options": {"colorMode": "background", "textMode": "value"}
    },
    {
      "id": 5,
      "title": "FFT peak (Hz) vs RMS (g)",
      "type": "xychart",
      "gridPos": {"h": 9, "w": 12, "x": 0, "y": 9},
      "datasource": {"type": "postgres", "uid": "pdm-timescale"},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT peak_hz AS x, rms_g AS y FROM features WHERE device_id = '$device_id' AND $__timeFilter(time) AND peak_hz IS NOT NULL"
        }
      ],
      "fieldConfig": {"defaults": {"custom": {"pointSize": 5}}}
    },
    {
      "id": 6,
      "title": "Thermal max housing temp (C)",
      "type": "timeseries",
      "gridPos": {"h": 9, "w": 12, "x": 12, "y": 9},
      "datasource": {"type": "postgres", "uid": "pdm-timescale"},
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT time AS \"time\", therm_max_c AS \"max C\", therm_mean_c AS \"mean C\" FROM features WHERE device_id = '$device_id' AND $__timeFilter(time) ORDER BY time"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {"lineWidth": 2, "fillOpacity": 5, "showPoints": "never"},
          "color": {"mode": "palette-classic"}
        }
      }
    },
    {
      "id": 7,
      "title": "Bad data - DLQ events (last 1h)",
      "type": "table",
      "gridPos": {"h": 8, "w": 14, "x": 0, "y": 18},
      "datasource": {"type": "postgres", "uid": "pdm-timescale"},
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT time, reason, device_id, substring(payload, 1, 80) AS payload_preview, substring(coalesce(error,''),1,120) AS error FROM dlq WHERE time > now() - interval '1 hour' ORDER BY time DESC LIMIT 50"
        }
      ],
      "options": {"showHeader": true}
    },
    {
      "id": 8,
      "title": "DLQ rate by reason (msg/min)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 10, "x": 14, "y": 18},
      "datasource": {"type": "postgres", "uid": "pdm-timescale"},
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT time_bucket('1 minute', time) AS \"time\", reason AS metric, count(*) AS value FROM dlq WHERE $__timeFilter(time) GROUP BY 1, reason ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {"lineWidth": 2, "drawStyle": "bars", "fillOpacity": 80}
        }
      }
    }
  ],
  "refresh": "5s",
